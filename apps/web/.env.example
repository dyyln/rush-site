# Set to 1 to render every page from mock data with no backend
NEXT_PUBLIC_MOCK=1
# Base URL of the api app
NEXT_PUBLIC_API_URL=http://localhost:3001
# Optional. Defaults to NEXT_PUBLIC_API_URL with ws scheme and /ws path
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
# Public origin of this site, used for absolute Open Graph URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3107
