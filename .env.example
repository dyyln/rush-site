# Copy to .env and fill in. Never commit .env.
# Values here work for local dev with `make dev` unless marked required.

# ---- General ----
NODE_ENV=development
LOG_LEVEL=info
IMAGE_TAG=dev

# Public URL of the website. Used for Steam OpenID return and links.
PUBLIC_URL=http://localhost:3000
# Public origin of the web app, used for absolute Open Graph URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3107
# Public URL of the API. Used for Steam OpenID realm and CORS.
API_PUBLIC_URL=http://localhost:3001
# Browser facing API URL. Baked into the web bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Optional. Defaults to NEXT_PUBLIC_API_URL with ws scheme plus /ws.
NEXT_PUBLIC_WS_URL=
# Contact address shown on the banned page for appeals
NEXT_PUBLIC_SUPPORT_EMAIL=support@duelrush.site

# ---- Secrets (required) ----
# The api refuses to start in production while these hold a change-me placeholder.
# openssl rand -hex 32
SESSION_SECRET=change-me-dev-session-secret-at-least-32-chars
# Parent domain for the session cookie when web and api are on sibling subdomains.
# Empty in dev. Prod example: .duelrush.site
COOKIE_DOMAIN=
# Comma separated SteamID64s with admin rights.
ADMIN_STEAM_IDS=
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# https://developers.faceit.com  Optional. Trust treats missing FACEIT as neutral.
FACEIT_API_KEY=
# Optional. Premier and Wingman ranks on profiles come from Leetify, which works without a key at a lower rate limit.
LEETIFY_API_KEY=
# Discord linking, from https://discord.com/developers/applications. Off unless all five ids are set.
# Add <API_PUBLIC_URL>/auth/discord/callback as an OAuth2 redirect.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_LINKED_ROLE_ID=
DISCORD_INVITE_URL=

# ---- Postgres ----
POSTGRES_USER=rushsite
POSTGRES_PASSWORD=rushsite
POSTGRES_DB=rushsite
# Used when running the api on the host with pnpm dev.
# Inside Docker the compose file points at the postgres service instead.
DATABASE_URL=postgres://rushsite:rushsite@localhost:5432/rushsite
# The api applies drizzle migrations on boot when true.
DB_MIGRATE_ON_START=true

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Object storage for demos ----
# Dev uses the minio service. The api container always uses http://minio:9000 in dev
# and this value applies to host runs and to prod, where it is Hetzner Object Storage,
# for example https://fsn1.your-objectstorage.com
S3_ENDPOINT=http://localhost:9000
# Endpoint used in presigned URLs. Must be reachable from the CS2 plugin on the host.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=rushsite-demos
S3_ACCESS_KEY_ID=rushsite
S3_SECRET_ACCESS_KEY=rushsite-dev-secret
S3_FORCE_PATH_STYLE=true

# ---- Host agent ----
# Shared bearer token between api and every agent. openssl rand -hex 32
RUSHSITE_AGENT_TOKEN=change-me-dev-agent-token
# Comma separated agent base URLs as seen from the api.
# From the api container use host.docker.internal. From the host use localhost.
AGENT_URLS=http://host.docker.internal:8080
# When running the api on the host with pnpm dev use this instead.
# AGENT_URLS=http://localhost:8080
# Base URL the CS2 plugin uses to post match webhooks to the api.
# The plugin runs on the same host so loopback is fine on a single box.

# Agent side settings. Read by the agent systemd unit, not by compose.
RUSHSITE_CS2_DIR=/srv/cs2
RUSHSITE_PORT_RANGE=27015-27030
RUSHSITE_PUBLIC_IP=

# ---- GSLT pool ----
# Game Server Login Tokens from a dedicated Steam account, one per Hetzner slot.
# DatHost surge servers run without one. https://steamcommunity.com/dev/managegameservers
# The pool lives in the database. Add tokens, edit memos and remove them on /admin/hosts.
# Optional seed. Comma separated tokens here are added on API start if missing, and
# existing rows are never changed. Leave it empty once the pool is managed from admin.
GSLT_TOKENS=

# ---- Production only (docker-compose.prod.yml and Caddy) ----
SITE_DOMAIN=duelrush.site
API_DOMAIN=api.duelrush.site
ACME_EMAIL=ops@duelrush.site

# ---- Backups (infra/scripts/db-backup.sh) ----
BACKUP_DIR=/var/backups/rushsite
BACKUP_RETENTION_DAYS=14
# Optional off box copy. Leave empty to keep backups local only.
BACKUP_S3_BUCKET=

# DatHost surge capacity (optional, disabled when DATHOST_EMAIL is empty). Use a dedicated DatHost account.
DATHOST_EMAIL=
DATHOST_PASSWORD=
DATHOST_TEMPLATE_SERVER_ID=
DATHOST_LOCATION=dusseldorf
SURGE_WAIT_SEC=20

# API timing and behaviour (optional)
DEMO_WAIT_SEC=180
# Match watchdog: hard caps per mode, silence before a live match is presumed dead, sweep interval
MATCH_MAX_MIN_AIM=60
MATCH_MAX_MIN_RUSH=40
MATCH_SILENCE_SEC=900
WATCHDOG_INTERVAL_SEC=30
ALLOCATION_TIMEOUT_SEC=60
CONNECT_TIMEOUT_SEC=300
MATCHMAKER_INTERVAL_MS=2000
MATCH_TICK_INTERVAL_MS=1000
SESSION_TTL_DAYS=30
ROLLBACK_WINDOW_DAYS=30
# RUSH1V1_TEST_QUEUE=1       # opens the unrated 1v1 Rush test queue
# RUSH2V2_TEST_QUEUE=1       # opens the unrated 2v2 Rush test queue
# RUSH_ROOM_VETO=1           # Rush room ban and pick on the site. Unset follows the shared config default
# ALLOW_UNRESOLVED_MODES=1   # dev only, lets aim modes queue before workshop ids are filled
# DISABLE_LOOPS=1            # dev only, no matchmaker or match tick loops
# RATE_LIMIT_ENABLED=0       # dev only, turns off HTTP rate limits. Refused in production
